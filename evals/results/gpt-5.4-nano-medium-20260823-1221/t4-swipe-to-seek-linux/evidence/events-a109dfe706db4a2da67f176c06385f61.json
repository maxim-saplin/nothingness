"test/widgets/hero_feedback_surface_test.dart","offset":20,"limit":80}}},{"sequence":11979,"timestamp":"2026-08-23T13:17:01.554742Z","elapsed_seconds":734.423,"source":"pi","event":{"type":"tool_execution_end","toolName":"read","toolCallId":"call_dQDBQrwHGEizwZB9CLz2t2E0|fc_0924a129a9da752a016a8af2c9277c81948fb2d1b73f2fcf65","result":{"content":[{"type":"text","text":"    Widget widget,\n    List<String> events,\n    List<Duration> seeks,\n  }) build({\n    HeroFlashController? flashController,\n    int positionMs = 10000,\n    int durationMs = 60000,\n  }) {\n    final events = <String>[];\n    final seeks = <Duration>[];\n    final hudUpdates = <({int? targetMs, int? durationMs, double? fraction})>[];\n    final w = SizedBox(\n      width: 400,\n      height: 400,\n      child: HeroFeedbackSurface(\n        flashController: flashController,\n        onPlayPause: () => events.add('playpause'),\n        onPrevious: () => events.add('previous'),\n        onNext: () => events.add('next'),\n        onSeek: (d) => seeks.add(d),\n        onSeekHudChanged: ({targetMs, durationMs, fraction}) {\n          hudUpdates.add(\n            (targetMs: targetMs, durationMs: durationMs, fraction: fraction),\n          );\n        },\n        positionMs: () => positionMs,\n        durationMs: () => durationMs,\n        child: const ColoredBox(color: Colors.black),\n      ),\n    );\n    return (widget: w, events: events, seeks: seeks, hudUpdates: hudUpdates);\n  }\n\n  group('tap ring', () {\n    testWidgets('appears on tap-down and disappears after the animation',\n        (tester) async {\n      final b = build();\n      await tester.pumpWidget(host(b.widget));\n\n      // Pre-tap: the ring slot widget isn't mounted yet.\n      expect(find.byKey(HeroFeedbackSurface.tapRingKey), findsNothing);\n\n      final gesture = await tester.startGesture(\n          tester.getCenter(find.byType(HeroFeedbackSurface)));\n      // Let kPressTimeout elapse so onTapDown fires, then commit the setSt