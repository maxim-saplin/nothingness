rt';\nimport 'package:nothingness/widgets/transport_row.dart';\nimport 'package:path/path.dart' as p;\nimport 'package:nothingness/controllers/library_controller.dart';\n\nclass _RecordingLibraryController extends LibraryController {\n  _RecordingLibraryController({\n    String? currentPath,\n    List<AudioTrack> tracks = const <AudioTrack>[],\n  }) : super(\n          libraryBrowser: LibraryBrowser(supportedExtensions: const {'mp3'}),\n          libraryService: LibraryService(),\n          isAndroidOverride: false,\n        ) {\n    this.currentPath = currentPath;\n    this.tracks = List<AudioTrack>.from(tracks);\n    hasPermission = true;\n  }\n\n  final List<String> loadFolderCalls = <String>[];\n\n  @override\n  Future<void> loadFolder(String path) async {\n    loadFolderCalls.add(path);\n    currentPath = path;\n    notifyListeners();\n  }\n}\n\nFuture<void> _writeBoundaryPng(\n  WidgetTester tester, {\n  required GlobalKey key,\n  required String outPath,\n}) async {\n  final boundaryFinder = find.byKey(key);\n  expect(boundaryFinder, findsOneWidget);\n  final boundary = tester.renderObject(boundaryFinder) as RenderRepaintBoundary;\n  final image = await boundary.toImage(pixelRatio: 1.0);\n  final byteData = await image.toByteData(format: ui.ImageByteFormat.png);\n  expect(byteData, isNotNull);\n  final bytes = byteData!.buffer.asUint8List();\n\n  await File(outPath).writeAsBytes(bytes, flush: true);\n}\n\nvoid main() {\n  TestWidgetsFlutterBinding.ensureInitialized();\n\n  setUp(() async {\n    SharedPreferences.setMockInitialValues(<String, Object>{});\n    SettingsService().immersiveNotifier.value = false;\n    SettingsService().transportPositionNotifier.value = TransportPosition.bottom;\n  });\n\n  testWidgets('swipe-to-seek feedback: crumb shows preview while dragging and clears after',\n      (tester) async {\n    await tester.binding.setSurfaceSize(const Size(800, 1600));\n\n    final boundaryKey = GlobalKey();\n    final provider = FakeAudioPlayerProvider(\n      songInfo: SongInfo(\n        track: const AudioTrack(path: '/lib/Music/x.wav', title: 'x'),\n        isPlaying: true,\n        position: 10000,\n        duration: 60000,\n      ),\n      isPlaying: true,\n    );\n\n    final lib = _RecordingLibraryController(\n      currentPath: '/lib/Music',\n      tracks: const <AudioTrack>[],\n    );\n\n    final app = MaterialApp(\n      theme: buildAppTheme(\n        id: ThemeId.void_,\n        brightness: Brightness.dark,\n      ),\n      home: Scaffold(\n        body: RepaintBoundary(\n          key: boundaryKey,\n          child: VoidScreen(\n            config: const SpectrumScreenConfig(),\n            settings: const SpectrumSettings(),\n            libraryController: lib,\n          ),\n        ),\n      ),\n    );\n\n    await tester.pumpWidget(ChangeNotifierProvider<PlaybackController>.value(\n      value: provider,\n      child: app,\n    ));\n\n    await tester.pump();\n\n    final hero = find.byType(HeroFeedbackSurface);\n    expect(hero, findsOneWidget);\n\n    final shotsDir = p.join('.tmp', 'agent_shots');\n    Directory(shotsDir).createSync(recursive: true);\n\n    final duringPath = p.join(shotsDir, 'seek_preview_during.png');\n    final afterPath = p.join(shotsDir, 'seek_preview_after.png');\n\n    final gesture = await tester.startGesture(tester.getCenter(hero));\n    await gesture.moveBy(const Offset(160, 0));\n    await tester.pump(const Duration(milliseconds: 16));\n\n    await _writeBoundaryPng(\n      tester,\n      key: boundaryKey,\n      outPath: duringPath,\n    );\n\n    await gesture.up();\n    await tester.pumpAndSettle();\n\n    await _writeBoundaryPng(\n      tester,\n      key: boundaryKey,\n      outPath: afterPath,\n    );\n\n    expect(File(duringPath).existsSync(), isTrue);\n    expect(File(afterPath).existsSync(), isTrue);\n  });\n}\n"}}],"api":"azure-openai-responses","provider":"azure-openai-responses","model":"gpt-5.4-nano","usage":{"input":312,"output":2293,"cacheRead":6425