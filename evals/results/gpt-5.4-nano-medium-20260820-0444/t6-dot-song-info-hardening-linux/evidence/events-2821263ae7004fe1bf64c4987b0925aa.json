out.write(proc.stdout)\n    return 0\n\n\ndef cmd_overflows(args) -> int:\n    params = {}\n    if args.clear:\n        params[\"clear\"] = \"true\"\n    res = _ext_resilient(\"ext.nothingness.getOverflowReports\", params)\n    print(json.dumps(res, indent=2))\n    return 0\n\n\ndef _flutter_fifo_write(command: str) -> bool:\n    \"\"\"Send a key command (e.g. 'r' / 'R') to flutter run's stdin via fifo.\n\n    Returns True if the fifo exists and the write succeeded.\"\"\"\n    if not FLUTTER_INPUT_FIFO.exists():\n        return False\n    try:\n        # The fifo must already have a long-lived reader (flutter run) and a\n        # long-lived writer holding it open (the sleep-infinity helper).\n        with open(FLUTTER_INPUT_FIFO, \"w\") as f:\n            f.write(command + \"\\n\")\n            f.flush()\n        return True\n    except Exception:\n        return False\n\n\ndef cmd_reload(args) -> int:\n    \"\"\"Hot reload via flutter run's stdin (sends 'r'). Falls back to\n    error if no flutter run is attached. Forces drive.py to invalidate the\n    cached WS URI in case sources structurally changed.\"\"\"\n    ok = _flutter_fifo_write(\"r\")\n    if not ok:\n        print(json.dumps({\n\n[1054 more lines in file. Use offset=710 to continue.]"}]},"isError":false}},{"sequence":4416,"timestamp":"2026-08-20T06:55:55.034938Z","elapsed_seconds":293.964,"source":"pi","event":{"type":"message_start","message":{"role":"toolResult","toolCallId":"call_P0rSZVUQs26qQai576qA7vX1|fc_021ccccc03ff0c40016a86a4f937b88190a1192eff44925bdb","toolName":"read","content":[{"type":"text","text":"    # back to a device-side write + pull on platforms where exec-out is finicky.\n    try:\n        proc = subprocess.run(\n            [\"adb\", \"-s\", DEFAULT_SERIAL, \"exec-out\", \"screencap\", \"-p\"],\n            check=True,\n            capture_output=True,\n            timeout=20,\n        )\n        out.write_bytes(proc.stdout)\n    except Exception:\n        device_tmp = f\"/sdcard/