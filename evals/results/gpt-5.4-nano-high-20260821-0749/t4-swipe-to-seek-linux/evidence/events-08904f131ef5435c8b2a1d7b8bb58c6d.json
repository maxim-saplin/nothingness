art","edits":[{"oldText":"import 'package:flutter/material.dart';\nimport 'package:flutter_hooks/flutter_hooks.dart';","newText":"import 'package:flutter/foundation.dart';\nimport 'package:flutter/material.dart';\nimport 'package:flutter_hooks/flutter_hooks.dart';"},{"oldText":"  const HeroFeedbackSurface({\n    super.key,\n    required this.child,\n    required this.onPlayPause,\n    required this.onPrevious,\n    required this.onNext,\n    required this.onSeek,\n    required this.positionMs,\n    required this.durationMs,\n    this.flashController,\n    this.onVerticalDragUpdate,\n    this.onVerticalDragEnd,\n  });","newText":"  const HeroFeedbackSurface({\n    super.key,\n    required this.child,\n    required this.onPlayPause,\n    required this.onPrevious,\n    required this.onNext,\n    required this.onSeek,\n    required this.positionMs,\n    required this.durationMs,\n    this.onSeekDragStarted,\n    this.onSeekDragEnded,\n    this.onSeekPreview,\n    this.flashController,\n    this.onVerticalDragUpdate,\n    this.onVerticalDragEnd,\n  });"},{"oldText":"  /// Commit a seek to [target]. Called once, when the drag is released.\n  final void Function(Duration target) onSeek;","newText":"  /// Commit a seek to [target]. Called once, when the drag is released.\n  final void Function(Duration target) onSeek;\n\n  /// Called when the horizontal drag-to-seek begins.\n  final VoidCallback? onSeekDragStarted;\n\n  /// Called when the horizontal drag-to-seek ends (even when [durationMs]\n  /// is 0, so callers can clear temporary UI).\n  final VoidCallback? onSeekDragEnded;\n\n  /// Called on every horizontal drag update with the current seek preview.\n  final void Function(int targetMs, int durationMs)? onSeekPreview;"},{"oldText":"  /// Stable keys for widget tests.\n  static const Key tapRingKey = ValueKey<String>('hero-tap-ring');\n  static const Key swipeFlashKey = ValueKey<String>('hero-swipe-flash');\n  static const Key seekHudKey = ValueKey<String>('hero-seek-hud');","newText":"  /// Stable keys for widget tests.\n  static const Key tapRingKey = ValueKey<String>('hero-tap-ring');\n  static const Key swipeFlashKey = ValueKey<String>('hero-swipe-flash');\n  static const Key seekHudKey = ValueKey<String>('hero-seek-hud');\n\n  /// Root touch surface key \u2014 used by automation to synthetic-drag seek.\n  static const Key surfaceKey = ValueKey<String>('hero-feedback-surface');"},{"oldText":"    void onSeekStart(DragStartDetails _) {\n      seekStartMs.value = positionMs();\n      seekDurationMs.value = durationMs();\n      seekAccumDx.value = 0;\n      seekTargetMs.value = seekStartMs.value;\n      seeking.value = true;\n    }","newText":"    void onSeekStart(DragStartDetails _) {\n      seekStartMs.value = positionMs();\n      seekDurationMs.value = durationMs();\n      seekAccumDx.value = 0;\n      seekTargetMs.value = seekStartMs.value;\n      seeking.value = true;\n\n      onSeekDragStarted?.call();\n      onSeekPreview?.call(seekTargetMs.value, seekDurationMs.value);\n    }"},{"oldText":"    void onSeekUpdate(DragUpdateDetails d) {\n      if (seekDurationMs.value <= 0) return;\n      seekAccumDx.value += d.primaryDelta ?? 0;\n      final raw = seekStartMs.value +\n          (seekAccumDx.value / width.value) * seekDurationMs.value;\n      seekTargetMs.value =\n          raw.clamp(0, seekDurationMs.value.toDouble()).round();\n    }","newText":"    void onSeekUpdate(DragUpdateDetails d) {\n      if (seekDurationMs.value <= 0) return;\n      seekAccumDx.value += d.primaryDelta ?? 0;\n      final raw = seekStartMs.value +\n          (seekAccumDx.value / width.value) * seekDurationMs.value;\n      seekTargetMs.value =\n          raw.clamp(0, seekDurationMs.value.toDouble()).round();\n      onSeekPreview?.call(seekTargetMs.value, seekDurationMs.value);\n    }"},{"oldText":"    void onSeekEnd(DragEndDetails _) {\n      final hadDuration = seekDurationMs.value > 0;\n      final target = seekTargetMs.value;\n      seeking.value = false;\n      if (hadDuration) {\n        onSeek(Duration(milliseconds: target));\n      }\n    }","newText":"    void onSeekEnd(DragEndDetails _) {\n      final hadDuration = seekDurationMs.value > 0;\n      final target = seekTargetMs.value;\n      seeking.value = false;\n      onSeekDragEnded?.call();\n      if (hadDuration) {\n        onSeek(Duration(milliseconds: target));\n      }\n    }"},{"oldText":"            // Seek HUD \u2014 time readout + preview line, only while scrubbing.\n            if (seeking.value)\n              Positioned.fill(\n                child: IgnorePointer(\n                  child: _SeekHud(\n                    fraction: seekDurationMs.value <= 0\n                        ? 0\n                        : (seekTargetMs.value / seekDurationMs.value)\n                            .clamp(0.0, 1.0),\n                    label: seekDurationMs.value <= 0\n                        ? '--:-- / --:--'\n                        : '${formatClock(seekTargetMs.value)} / ${formatClock(seekDurationMs.value)}',\n                    palette: palette,\n                    typography: typography,\n                  ),\n                ),\n              ),","newText":"            // Seek HUD \u2014 time readout + preview line (suppressed on Linux where\n            // the seek preview is surfaced in the bottom crumb line instead).\n            if (seeking.value && defaultTargetPlatform != TargetPlatform.linux)\n              Positioned.fill(\n                child: IgnorePointer(\n                  child: _SeekHud(\n                    fraction: seekDurationMs.value <= 0\n                        ? 0\n                        : (seekTargetMs.value / seekDurationMs.value)\n                            .clamp(0.0, 1.0),\n                    label: seekDurationMs.value <= 0\n                        ? '--:-- / --:--'\n                        : '${formatClock(seekTargetMs.value)} / ${formatClock(seekDurationMs.value)}',\n                    palette: palette,\n       