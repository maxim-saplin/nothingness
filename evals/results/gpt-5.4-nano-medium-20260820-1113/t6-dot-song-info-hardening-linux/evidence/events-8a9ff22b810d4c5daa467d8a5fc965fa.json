:"lib/widgets/heroes/hero_title_block.dart"}}],"api":"azure-openai-responses","provider":"azure-openai-responses","model":"gpt-5.4-nano","usage":{"input":496,"output":64,"cacheRead":14080,"cacheWrite":0,"reasoning":37,"totalTokens":14640,"cost":{"input":9.920000000000001e-05,"output":8e-05,"cacheRead":0.0002816,"cacheWrite":0,"total":0.00046080000000000003}},"stopReason":"toolUse","timestamp":1787232576295,"responseId":"resp_05dc0738165f0713016a87014123508194bdcf79507f33db37","rawStopReason":"completed"}}},{"sequence":806,"timestamp":"2026-08-20T13:29:47.020025Z","elapsed_seconds":89.69,"source":"pi","event":{"type":"tool_execution_start","toolName":"read","toolCallId":"call_MU367PNjkMJMxFfuFPI9RW64|fc_05dc0738165f0713016a8701481540819486933096add8e4e0","args":{"path":"lib/widgets/heroes/hero_title_block.dart"}}},{"sequence":807,"timestamp":"2026-08-20T13:29:47.145302Z","elapsed_seconds":89.816,"source":"pi","event":{"type":"tool_execution_end","toolName":"read","toolCallId":"call_MU367PNjkMJMxFfuFPI9RW64|fc_05dc0738165f0713016a8701481540819486933096add8e4e0","result":{"content":[{"type":"text","text":"import 'package:flutter/material.dart';\nimport 'package:provider/provider.dart';\n\nimport '../../services/playback_controller.dart';\nimport '../../theme/app_palette.dart';\nimport '../../theme/app_typography.dart';\n\n/// Song title (H2) size as a fraction of the Artist (H1) size.\nconst double heroSongSizeFactor = 0.5;\n\nTextStyle heroHeadingStyle(\n  AppTypography typography, {\n  required Color color,\n  required double fontSize,\n}) =>\n    TextStyle(\n      color: color,\n      fontFamily: typography.monoFamily,\n      fontSize: fontSize,\n      letterSpacing: typography.heroLetterSpacing,\n      fontWeight: FontWeight.w300,\n      height: 1.18,\n    );\n\n/// Two-level hero title shared by Void, Spectrum and Dot: Artist (H1) over Song\n/// (H2), scaled by [textScale]. No artist \u2192 the song takes the H1 slot; no track\n/// \u2192 the \"nothingness\" idle headline, plus a gesture hint when [showIdleHint]. A\n/// `\u21a9`/`\u2248` glyph marks one-shot / shuffle on the lower line.\nclass HeroTitleBlock extends StatelessWidget {\n  const HeroTitleBlock({\n    super.key,\n    this.textScale = 1.0,\n    this.showIdleHint = false,\n  });\n\n  final double textScale;\n  final bool showIdleHint;\n\n  @override\n  Widget build(BuildContext context) {\n    final palette = Theme.of(context).extension<AppPalette>()!;\n    final typography = Theme.of(context).extension<AppTypography>()!;\n    final track = context.select<PlaybackController, ({String? title, String? artist})?>(\n      (player) {\n        final currentTrack = player.songInfo?.track;\n        if (currentTrack == null) return null;\n        return (title: currentTrack.title, artist: currentTrack.artist);\n      },\n    );\n    final isOneShot =\n        context.select<PlaybackController, bool>((player) => player.isOneShot);\n    final shuffle =\n        context.select<PlaybackController, bool>((player) => player.shuffle);\n\n    final h1Size = typography.heroSize * textScale;\n    final h2Size = typography.heroSize * heroSongSizeFactor * textScale;\n\n    Widget heading(String text,\n            {required Key key,\n            required Color color,\n            required double fontSize}) =>\n        Text(\n          text,\n          key: key,\n          textAlign: TextAlign.center,\n          maxLines: 2,\n          overflow: TextOverflow.ellipsis,\n          style: heroHeadingStyle(typography, color: color, fontSize: fontSize),\n        );\n\n    final List<Widget> children;\n    if (track == null) {\n      children = [\n        heading('nothingness',\n            key: const ValueKey('hero-artist'),\n            color: palette.fgPrimary,\n            fontSize: h1Size),\n        if (showIdleHint) ...[\n          const SizedBox(height: 12),\n          Text(\n            'long-press a folder \u00b7 \u2190\u2192 skip \u00b7 settings \u2197',\n            maxLines: 1,\n            overflow: TextOverflow.ellipsis,\n            textAlign: TextAlign.center,\n            style: TextStyle(\n              color: palette.fgTertiary,\n              fontFamily: typography.monoFamily,\n              fontSize: typography.hintSize * textScale,\n              letterSpacing: 0.18,\n            ),\n          ),\n        ],\n      ];\n    } else {\n        final artist = track.artist?.trim() ?? '';\n        final glyph = isOneShot\n          ? '\u21a9 '\n          : shuffle\n              ? '\u2248 '\n              : '';\n        final song = heading('$glyph${track.title ?? ''}',\n          key: const ValueKey('hero-song'),\n          color: artist.isEmpty ? palette.fgPrimary : palette.fgSecondary,\n          fontSize: artist.isEmpty ? h1Size : h2Size);\n      children = artist.isEmpty\n          ? [song]\n          : [\n              heading(artist,\n                  key: const ValueKey('hero-artist'),\n                  color: palette.fgPrimary,\n                  fontSize: h1Size),\n              const SizedBox(height: 8),\n              song,\n            ];\n    }\n\n    return Padding(\n      padding: const EdgeInsets.symmetric(horizontal: 56),\n      child: Column(\n        mainAxisSize: MainAxisSize.min,\n        mainAxisAlignment: MainAxisAlignment.center,\n        children: children,\n      ),\n    );\n  }\n}\n"}]},"isError":false}}]}
