nfig: cfg as DotScreenConfig);\n        case ScreenType.cassette:\n          return CassetteHero(config: cfg as CassetteScreenConfig);\n      }\n    }\n\n    // --- builders ------------------------------------------------------------\n\n    // Wraps the hero in a [HeroFeedbackSurface]; vertical drag is wired only when\n    // the swipe-up browser is collapsed. positionMs/durationMs are getters so\n    // position ticks don't rebuild.\n    Widget buildHeroGestureSurface({required Widget child}) {\n      final player = context.read<PlaybackController>();\n      final acceptVertical =\n          browserPresentation.value == BrowserPresentation.swipeUp &&\n          !browserExpanded.value;\n      final seekCrumbFeedbackMode = defaultTargetPlatform == TargetPlatform.linux;\n      return HeroFeedbackSurface(\n        showSeekHud: !seekCrumbFeedbackMode,\n        onSeekFeedbackUpdate: seekCrumbFeedbackMode\n            ? (targetMs, durationMs, fraction) {\n                seekCrumbFeedback.value = _SeekCrumbFeedback(\n                  targetMs: targetMs,\n                  durationMs: durationMs,\n                  fraction: fraction,\n                );\n              }\n            : null,\n        onSeekFeedbackEnd: seekCrumbFeedbackMode\n            ? () => seekCrumbFeedback.value = null\n            : null,\n        flashController: heroFlashController,\n        onPlayPause: () => player.playPause(),\n        onPrevious: () => player.previous(),\n        onNext: () => player.next(),\n        onSeek: (d) => player.seek(d),\n        positionMs: () => player.songInfo?.position ?? 0,\n        durationMs: () => player.songInfo?.duration ?? 0,\n\n[471 more lines in file. Use offset=540 to continue.]"}]},"isError":false}},{"sequence":17206,"timestamp":"2026-08-22T07:56:22.833946Z","elapsed_seconds":1092.512,"source":"pi","event":{"type":"message_start","message":{"role":"toolResult","toolCallId":"call_n4pLEvnGBC5f17Z0hXwP3cDm|fc_0339ba09b38c0c4b016a89562597588193b63f058eca