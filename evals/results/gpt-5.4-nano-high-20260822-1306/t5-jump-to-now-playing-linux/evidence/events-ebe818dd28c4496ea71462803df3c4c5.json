tFullScreen(bool enable, {bool save = true}) async {\n    if (save) {\n      final prefs = await SharedPreferences.getInstance();\n      await prefs.setBool(_fullScreenKey, enable);\n      fullScreenNotifier.value = enable;\n    }\n\n    if (enable) {\n      await SystemChrome.setEnabledSystemUIMode(SystemUiMode.immersiveSticky);\n      SystemChrome.setSystemUIOverlayStyle(const SystemUiOverlayStyle(\n        statusBarColor: Color(0x00000000),\n\n[30 more lines in file. Use offset=420 to continue.]"}],"isError":false,"timestamp":1787412286682}}},{"sequence":10570,"timestamp":"2026-08-22T15:24:47.813315Z","elapsed_seconds":646.204,"source":"pi","event":{"type":"turn_end","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","thinkingSignature":"{\"id\":\"rs_07953e9c51e20bfa016a89bf3e541481979c707335b4021800\",\"type\":\"reasoning\",\"content\":[],\"encrypted_content\":\"gAAAAABqib8_csLeUF5Kn7c00hnWDW7k9XNSBzSEpD4lPEFxJEAq40pkE1wnq5_5RJDrGVkUc4-CQ08ToajysvD7TFC091Pvy7_BbVGXMxt_EiKcqLotu52sSC4ZlV9doK53Gvc4fGHP9wWkbgcAEmlB4NGFTfQwwIbV1BSgGPInMjGh7_F_bWlv0e_VYWGzSr27FpvRiRdp2bRBOShpHucx5Fyz8GLKKInrjtvsOBZgu7_EJY58lcPeNOQKlwfu6gzbhFoQLVlVMJLjmsoQyZBz5GETJwrKQ2NfdfKyA2zwswRDsBrn-Saf4hL8Nz7HhpChzUJ4ftMkliraGh8oxTbwbq55VPCpbx5w3Xw0G2MAxq1QXUcF6aXO0DFdOvtj_Y7wnA44QduZxqeKr62UXhAjlJmuyPL1KrkOLhzN3n5Gcx0VZMs3TlDPaW76rd_BOO2ukf8XFA49PZb30NKH61fumOho3NS5fObkJMQrMqD8P6HOMmcLYOZv-SnutaBB8xLRgBH-xYBc6Z0rympAvUMwYuayB3Vcxit1nucZYlEtYjB19Ea8P6u7yJNLpGmtH-vaB-OXthoEMvwLgBxPL8f6kQb8MWBmFzGYBjNIE6gSQ4NkOFyrvq6J_ZRi5MlXWjP6TvsPTiSCVq1RZhHJuph_P7YzjNMd9kiXGr4XxaAZeOeSpLsY136UqzMB-DghNZQ9xnq6U9FbN4f-MChGt42-MDQ2UpDRqvsvdW0d-mJhbQwdPV5gaFPwFtgXep5i_xLKkzkXmcqXsbEmlSCMOS5fIQCmrkQ1_f_Ce--iePgtjrQWRJzGjGipsnVmTed10z9CUI6LezUJwwAuIsgH1FfcdJIhPMedKT2BRIQ_uHOKk-LCZuhwOGZVWvBNNI3PhyKLnv1LIh3iTwDYlmKNSHWi5IvS7AYKYI32nNWPVFLbqS6Y9AGgrwsXAzp5rWPQ-sl94ERQ1YTgnT_kA2jjd-3yHRfdCztc_UtL2f5BtrDWXlFZcgsagDDi_zj-ODaJeBl4KvfAZWp4MqoIIGdv4rQbY59OPEhki5MYJ8ZkOxKU0r2VgrlQuGy-fy_VrGtMrRBE6nAdI_