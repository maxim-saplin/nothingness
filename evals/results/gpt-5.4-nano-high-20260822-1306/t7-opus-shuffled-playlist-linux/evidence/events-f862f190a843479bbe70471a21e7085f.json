 .map((f) => f.path)\n        .toList()\n      ..sort();\n\n    expect(fixturePaths.length, 10,\n        reason: 'Expected exactly 10 .opus fixtures in ${fixtureDir.path}');\n    expect(fixturePaths.toSet().length, 10,\n        reason: 'Expected fixture paths to be unique');\n\n    await app.main();\n    await tester.pumpAndSettle();\n\n    final h = TestHarness.instance;\n    h.setOutcomes(const {});\n\n    final tracks = fixturePaths\n        .map((p) => AudioTrack(path: p, title: p.split('/').last))\n        .toList(growable: false);\n\n    await h.setQueue(tracks, startIndex: 0, shuffle: true);\n    await tester.pumpAndSettle();\n\n    final controller = h.controller;\n    expect(controller, isNotNull);\n\n    final beforeIndex = controller!.currentIndex;\n    final beforePath = controller.currentIndex == null\n        ? null\n        : controller.queue[beforeIndex!].path;\n\n    expect(controller.shuffle, isTrue);\n    expect(beforeIndex, isNotNull);\n    expect(beforePath, isNotNull);\n    expect(fixturePaths.contains(beforePath), isTrue);\n\n    // Verify the queue set is exactly the fixture set (order may change).\n    final queuePaths = controller.queue.map((t) => t.path).toSet();\n    expect(queuePaths.length, 10);\n    expect(queuePaths, fixturePaths.toSet());\n\n    await tester.tap(find.byKey(TestKeys.next));\n    await tester.pumpAndSettle();\n\n    await _pumpUntil(tester, () {\n      final idx = controller.currentIndex;\n      return idx != null && idx == beforeIndex + 1;\n    });\n\n    final afterIndex = controller.currentIndex;\n    final afterPath = controller.queue[afterIndex!].path;\n\n    print('OPUS_FIXTURES_TEST before=${beforePath} after=${afterPath}');\n\n    expect(afterIndex, equals(beforeIndex + 1));\n    expect(fixturePaths.contains(afterPath), isTrue);\n    expect(afterPath, isNot(equals(beforePath)));\n  });\n}\n"}}],"api":"azure-openai-responses","provider":"azure-openai-responses","model":"gpt-5.4-nano","usage":{"input":314,"output