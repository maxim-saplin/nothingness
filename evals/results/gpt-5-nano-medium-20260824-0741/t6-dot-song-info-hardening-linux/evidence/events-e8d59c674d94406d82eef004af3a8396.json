                  builder: (context, _) {\n                      final r = _radiusFor(player.spectrumData, adjustedMaxAllowed);\n                      return Container(\n                        width: r * 2,\n                        height: r * 2,\n                        decoration: BoxDecoration(\n                          color: palette.fgPrimary\n                              .withValues(alpha: config.dotOpacity),\n                          shape: BoxShape.circle,\n                        ),\n                      );\n                    },\n                  ),\n                ),\n              ),\n              // Optional song-info overlay pinned to the top of the hero band (B-020), above the dot.\n              if (config.showSongInfo)\n                Positioned(\n                  left: 0,\n                  right: 0,\n                  top: 12,\n                  child: Opacity(\n                    opacity: config.textOpacity.clamp(0.0, 1.0),\n                    child: HeroTitleBlock(textScale: config.textScale),\n                  ),\n                ),\n            ],\n          ),\n        );\n      },\n    );\n  }\n}\n"}],"isError":false,"timestamp":1787564663291}}},{"sequence":5810,"timestamp":"2026-08-24T09:44:28.710092Z","elapsed_seconds":353.092,"source":"pi","event":{"type":"message_end","message":{"role":"toolResult","toolCallId":"call_H111dt2gjlcWBycbsoUKTT7R|fc_07f03d776aba0b89016a8c12771d1081979fb93fb15f07deaa","toolName":"read","content":[{"type":"text","text":"import 'dart:math';\n\nimport 'package:flutter/material.dart';\nimport 'package:provider/provider.dart';\n\nimport '../../models/screen_config.dart';\nimport '../../services/playback_controller.dart';\nimport '../../theme/app_palette.dart';\nimport 'base_hero_container.dart';\nimport 'hero_title_block.dart';\n\n/// Dot visualisation embedded in the Void hero slot: a single pulsing circle whose radius tracks the spectrum's bass energy (Void chrome owns transport). When [DotScreenCon