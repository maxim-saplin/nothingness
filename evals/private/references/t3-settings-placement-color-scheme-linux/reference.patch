+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:nothingness/models/operating_mode.dart';
+import 'package:nothingness/models/screen_config.dart';
+import 'package:nothingness/models/theme_id.dart';
+import 'package:nothingness/services/settings_service.dart';
+import 'package:nothingness/theme/themes.dart';
+import 'package:nothingness/widgets/void_settings_sheet.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+Widget _wrap(Widget child) => MaterialApp(
+      theme: buildAppTheme(id: ThemeId.void_, brightness: Brightness.dark),
+      home: child,
+    );
+
+Future<void> _pumpInTallViewport(WidgetTester tester, Widget app) async {
+  await tester.binding.setSurfaceSize(const Size(800, 2400));
+  await tester.pumpWidget(app);
+  await tester.pump();
+  addTearDown(() => tester.binding.setSurfaceSize(null));
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  setUp(() async {
+    SharedPreferences.setMockInitialValues(<String, Object>{});
+    final settings = SettingsService();
+    settings.operatingModeNotifier.value = OperatingMode.own;
+    await settings.saveScreenConfig(const CassetteScreenConfig());
+  });
+
+  testWidgets('cassette color scheme follows screen directly and cycles', (tester) async {
+    await _pumpInTallViewport(tester, _wrap(const VoidSettingsSheet()));
+
+    final screen = find.byKey(
+      const ValueKey('void-settings-screen'),
+      skipOffstage: false,
+    );
+    final cassette = find.byKey(
+      const ValueKey('void-settings-cassette-variant'),
+      skipOffstage: false,
+    );
+    expect(screen, findsOneWidget);
+    expect(cassette, findsOneWidget);
+
+    final screenRect = tester.getRect(screen);
+    final cassetteRect = tester.getRect(cassette);
+    expect(cassetteRect.top, screenRect.bottom);
+    expect(
+      find.descendant(of: cassette, matching: find.text('color scheme')),
+      findsOneWidget,
+    );
+    expect(
+      find.descendant(of: cassette, matching: find.text('variant')),
+      findsNothing,
+    );
+
+    const initialValue = 'Tape · Mono';
+    const nextValue = 'Tape · Amber';
+    expect(find.descendant(of: cassette, matching: find.text(initialValue)), findsOneWidget);
+    await tester.tap(cassette);
+    await tester.pump();
+    final postScreenRect = tester.getRect(screen);
+    final postCassetteRect = tester.getRect(cassette);
+    expect(postCassetteRect.top, postScreenRect.bottom);
+    expect(find.descendant(of: cassette, matching: find.text(nextValue)), findsOneWidget);
+    expect(find.descendant(of: cassette, matching: find.text(initialValue)), findsNothing);
+    expect(
+      find.descendant(of: cassette, matching: find.text('color scheme')),
+      findsOneWidget,
+    );
+  });
+}
