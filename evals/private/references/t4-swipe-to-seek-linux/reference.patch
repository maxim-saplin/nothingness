+    final state = _activeDragState(drag);
+    _finishActiveSyntheticDrag(canceled: canceled);
+    SchedulerBinding.instance.scheduleFrame();
+    await SchedulerBinding.instance.endOfFrame;
+    return _ok({'ended': true, 'active': false, 'canceled': canceled, ...state});
+  }
